# Copy to .env (gitignored, chmod 600). mise loads it into every shell in this folder.

# OpenRouter — image (Nano Banana) and video (Seedance 2.5) generation. https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Meta — System User token from Business Settings > System users > Generate token
# (assets: the ad account, the Facebook Page, the pixel/dataset; permissions:
# ads_management, ads_read, business_management, pages_read_engagement, instagram_basic).
# The Meta Ads CLI (`meta`) reads ACCESS_TOKEN and AD_ACCOUNT_ID; scripts/ read the same.
ACCESS_TOKEN=
AD_ACCOUNT_ID=act_
BUSINESS_ID=

# Resolved once with `mise run verify` and then pinned here so every launch uses the same identity.
META_PAGE_ID=
META_INSTAGRAM_ACTOR_ID=
META_PIXEL_ID=1194380562291350

# Optional — Instagram ingest with a logged-in session (see scripts/ig-login.mjs). Never put a password here.
IG_USERNAME=
